# Copy this file to fork/deploy.env ON THE SERVER and fill in the four blank secrets.
# Generate a DIFFERENT value for each secret with: openssl rand -hex 32
# Keep deploy.env private and keep its values unchanged across normal updates.
# Use hexadecimal passwords so they can safely appear in the database/Redis URLs.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

# Server-local image built from the checked-out source; not an official image.
NEW_API_TAG=local

# Record failed relay attempts in the usage logs.
ERROR_LOG_ENABLED=true

# Default is only reachable on the server. Use an HTTPS reverse proxy or SSH tunnel.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001

# Initial server-local HTTP access (for example, over an SSH tunnel):
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=

# When exposing through your HTTPS domain, set BOTH values appropriately:
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_TRUSTED_URL=https://your-actual-domain.example
